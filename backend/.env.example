# LLM配置（兼容 OpenAI-compatible 服务，如 DashScope、DeepSeek、OpenAI 兼容网关）
LLM_MODEL_ID=qwen3.6-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=60
LLM_CONNECT_TIMEOUT=8
LLM_MAX_RETRIES=0
LLM_ENABLE_THINKING=false

# 百炼向量模型默认使用 EMBEDDING_API_KEY；未配置时会复用 LLM_API_KEY。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL_ID=tongyi-embedding-vision-plus-2026-03-06
EMBEDDING_DIMENSIONS=512
EMBEDDING_API_KEY=

# fast: 景点/天气/酒店使用大模型辅助，Planner 使用本地快速整合；quality: Planner 也调用大模型。
PLANNER_MODE=fast

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置。部署到 GitHub Pages 后，把前端地址加入这里，例如：
# https://你的用户名.github.io/travel_assistant
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# 日志级别
LOG_LEVEL=INFO

# 研究资料缓存
RESEARCH_CACHE_ENABLED=true
RESEARCH_CACHE_TTL_SECONDS=86400
RESEARCH_CACHE_MAX_ENTRIES=200

# 实时旅行资料搜索 MCP。可接 Tavily、Brave Search 等 web_search 风格 MCP。
# 示例：WEB_SEARCH_MCP_COMMAND=["npx","-y","tavily-mcp"]
WEB_SEARCH_MCP_COMMAND=
WEB_SEARCH_MCP_TOOL=web_search
MCP_TIMEOUT_SECONDS=20

# RollingGo Hotel MCP: 智能问答中的酒店实时房价查询
# ROLLINGGO_HOTEL_MCP_URL 示例以 RollingGo 官方控制台/文档为准
ROLLINGGO_HOTEL_MCP_URL=
ROLLINGGO_HOTEL_API_KEY=
ROLLINGGO_HOTEL_ACCEPT_LANGUAGE=zh_CN

# RSS 只作为长期知识库补充，多个 URL 用英文逗号分隔。
# 建议优先放官方文旅、景区、博物馆或稳定旅行指南源。
# rsshub.app 不稳定时可以改成自建实例或公共实例，例如 https://rsshub.rssforever.com
RSSHUB_BASE_URL=https://rsshub.rssforever.com
TRAVEL_FEEDS=

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Image search provider keys
# Wikimedia Commons and Openverse can be used without keys.
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
WIKIMEDIA_USER_AGENT=travel-assistant/1.0 (contact: your-email@example.com)

# 高德地图 API 配置
AMAP_API_KEY=
AMAP_MAPS_API_KEY=

# PostgreSQL 报告存储与旅行向量知识库（二选一：DATABASE_URL 或拆分配置）
# 智能问答会复用此数据库，并要求 PostgreSQL 已安装 pgvector 扩展。
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT 认证
JWT_SECRET_KEY=please-change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Redis and distributed rate limiting. Prefer REDIS_URL, or configure the
# individual REDIS_* fields. Never commit real credentials.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_SECONDS=2
# Standard redis-py socket read timeout. REDIS_READ_TIMEOUT_SECONDS remains a
# supported legacy alias when this value is unset.
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=20
KNOWLEDGE_JOB_TTL_SECONDS=604800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS_ISSUE_LIMIT=20
RATE_LIMIT_REGISTER_LIMIT=10
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_QA_LIMIT=20
RATE_LIMIT_PLANNING_LIMIT=5
RATE_LIMIT_MAP_LIMIT=60
RATE_LIMIT_KNOWLEDGE_READ_LIMIT=30
RATE_LIMIT_KNOWLEDGE_WRITE_LIMIT=5
